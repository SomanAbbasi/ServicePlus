# ── Backend ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api
FRONTEND_URL=http://localhost:3000

# ── PostgreSQL (Neon) ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require

# ── Redis (Redis Cloud) ──────────────────────────────────
REDIS_URL=redis://default:password@your-redis-host:port

# ── JWT Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Admin Phones (comma-separated, auto-grants admin role on login) ──
ADMIN_PHONES=+971501234567,+971509876543

# ── OTP (development mock by default) ───────────────────
OTP_PROVIDER=mock
# OTP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# ── Payments (development mock by default) ───────────────
PAYMENT_PROVIDER=mock
# PAYMENT_PROVIDER=telr
# TELR_MERCHANT_ID=
# TELR_API_KEY=

# ── Storage ──────────────────────────────────────────────
# Options: local | r2
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# Cloudflare R2 (uncomment when ready)
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET=your-bucket-name
# R2_ACCESS_KEY=your-r2-access-key
# R2_SECRET_KEY=your-r2-secret-key
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ── Mapbox ─────────────────────────────────────────────
MAPBOX_API_KEY=

